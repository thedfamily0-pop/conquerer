# Keep both false for the default offline-first/static PWA.
VITE_SUPABASE_SYNC_ENABLED=false
VITE_AI_GATEWAY_ENABLED=false
# Set these only in the hosting environment after Supabase Auth, RLS, and migrations are tested.
# Never commit real values here. If either value is missing, the app remains offline-first.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_TEST_RECIPIENT, APP_ORIGIN, and APP_URL are Supabase Edge Function values, not Vite variables.
# APP_ORIGIN is the scheme-and-host browser origin for CORS (for example, https://example.github.io).
# APP_URL is the full deployed app URL used in welcome links (for example, https://example.github.io/conquerer/).
# While RESEND_FROM_EMAIL=onboarding@resend.dev, RESEND_TEST_RECIPIENT must be the Resend account email.

# Development/demo only. Never enable in production.
VITE_ALLOW_DIRECT_AI=false
